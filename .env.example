# ローカル起動（make run）用。コピーして .env を作成する。docker compose では compose 側の environment を使う。
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=debug

# make seed 用。root ユーザーの認証情報（未設定なら users / settings の投入をスキップ）
SEED_ROOT_EMAIL=root@example.com
SEED_ROOT_PASSWORD=password

# 選手画像の配信元URL。未設定（既定）なら /api/v1/rosters の image_url は常に null
ASSET_BASE_URL=
